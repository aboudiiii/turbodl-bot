# Telegram
BOT_TOKEN=123456:ABC-DEF...

# Optional Telegram Local Bot API server (https://github.com/tdlib/telegram-bot-api).
# Point this at the local server (default port 8081) to lift the 50 MB Cloud API
# upload cap and allow files up to 2 GB. Leave empty to use api.telegram.org.
TELEGRAM_LOCAL_API_URL=http://127.0.0.1:8081

# Comma-separated admin Telegram user IDs (you, the owner)
ADMIN_IDS=111111111,222222222

# Optional private beta mode: only these user IDs can use the bot
PRIVATE_MODE=false
ALLOWED_USER_IDS=

# Premium pricing
PREMIUM_PRICE_IQD=5000
PREMIUM_DURATION_DAYS=30

# Your Zain Cash number shown to users (e.g., 0781 234 5678)
ZAIN_CASH_NUMBER=07812345678

# Free tier limits
FREE_DAILY_LIMIT=3
FREE_MAX_FILE_SIZE_MB=50

# Premium file size cap (2000 = 2GB). 2048 is fine when using the
# Telegram Local Bot API server. Cloud API caps uploads at 50MB.
PREMIUM_MAX_FILE_SIZE_MB=2048
# With the Local Bot API server (TELEGRAM_LOCAL_API_URL) set, raise this to 2048
# so premium users can receive files up to 2 GB.
TELEGRAM_UPLOAD_LIMIT_MB=2048

# Admins (ADMIN_IDS) bypass the 50MB upload cap entirely, up to Telegram's
# full bot limit (2GB). Requires the Local Bot API server for >50MB uploads.
ADMIN_MAX_FILE_SIZE_MB=2048

# Aria2 connections (premium / free)
ARIA2_CONNECTIONS_PREMIUM=16
ARIA2_CONNECTIONS_FREE=4

# Auto-clear a user's download queue after this many seconds with no progress
STUCK_DOWNLOAD_TIMEOUT=900

# Max media download jobs running at once (global). Others wait in a FIFO
# queue and are shown their position.
MAX_ACTIVE_DOWNLOADS=3

# How long to keep cached file_id entries for duplicate URLs (days). A
# repeated link/format is forwarded instantly from cache instead of re-downloading.
CACHE_TTL_DAYS=7

# Master switch for the media cache (true/false)
CACHE_ENABLED=true

# Cap on cached file_id rows. Oldest entries are pruned first.
MAX_CACHE_ENTRIES=2000

# How many users each /broadcast batch is sent to before a short pause.
BROADCAST_BATCH_SIZE=25

# Bonus download quota per successful referral
REFERRAL_BONUS_DOWNLOADS=3

# Optional bonus Premium days per referral (0 = disabled)
REFERRAL_BONUS_PREMIUM_DAYS=0

# Max videos processed by one "download all" playlist job
PLAYLIST_MAX_ITEMS=30

# Max items shown in the playlist "pick a video" selector
PLAYLIST_PICK_LIMIT=12

# How many results /search returns
SEARCH_RESULTS=5

# ffmpeg binary used for the trim feature (leave empty to disable trim)
FFMPEG_BIN=ffmpeg

# Netscape-format cookies.txt handed to yt-dlp. Export cookies from a browser
# session logged into Instagram (extension: "Get cookies.txt LOCALLY") and save
# the file as cookies.txt next to bot.py - this fixes Instagram's "empty media
# response" / login-wall / rate-limit failures. Missing file = disabled.
YTDLP_COOKIES_FILE=cookies.txt

# Welcome banner shown as a photo above the main menu. Set an https:// image
# URL or a local image path (the project bundles "banner.png" by default).
# Leave both empty to keep the plain-text menu.
WELCOME_BANNER_URL=
WELCOME_BANNER_PATH=banner.png

# Force-sub channels (comma-separated, e.g. "@ch1,@ch2"). Bot must be admin in
# each. Leave empty to disable. FORCE_SUB_CHANNEL is the legacy single value.
FORCE_SUB_CHANNELS=
FORCE_SUB_CHANNEL=
# Optional invite link fallback for numeric channel ids
FORCE_SUB_INVITE=

# Bonus download credits granted once when a user passes the channel check
FORCE_SUB_BONUS_CREDITS=5

# Admin user id receiving live join/referral alerts (falls back to first ADMIN_IDS)
ADMIN_ID=

# Single bot owner (highest authority for admin commands). Falls back to
# ADMIN_ID when empty. Owner cannot be banned via /ban.
BOT_OWNER_ID=

# Channel/chat receiving system logs (new users, referrals, downloads).
# Falls back to ADMIN_ID when empty.
LOG_CHANNEL_ID=

# Start-screen (BotFather) texts, applied on startup via setMyShortDescription /
# setMyDescription. Leave a value empty to skip that language. Set false to skip
# the whole profile setup. Literal \n becomes a newline.
BOT_PROFILE_SETUP=true
BOT_SHORT_DESCRIPTION_AR=بوت توربودي إل العراقي — تحميل فيديو و MP3 سريع من أكثر من 15 موقع. حصة مجانية يومياً، وبريميوم حتى 2 جيجا.
BOT_SHORT_DESCRIPTION_EN=TurboDL Iraq Bot — fast video & MP3 downloads from 15+ sites. Free daily quota, premium files up to 2 GB.
BOT_DESCRIPTION_AR=بوت توربودي إل — حمّل الفيديو والصوت والـ MP3 من يوتيوب وتيك توك وانستغرام وفيسبوك وتويتر وساوند كلاود وغيرها.\n\n⚡ جودة حتى 1080p\n🎵 استخراج MP3\n▶️ قوائم تشغيل وبحث يوتيوب\n✂️ قص واقتطاع المقاطع\n🗂 إرسال فوري للملفات المتكررة\n\n3 تحميلات مجانية كل يوم.\nبريميوم ترفع الحجم إلى 2 جيجا دون حد يومي.\n\nأرسل الرابط للبدء 🚀
BOT_DESCRIPTION_EN=TurboDL Iraq Bot\n\nDownload videos, audio and MP3 from YouTube, TikTok, Instagram, Facebook, Twitter, SoundCloud and more.\n\n⚡ Quality choices up to 1080p\n🎵 MP3 audio extraction\n▶️ Playlists & YouTube /search\n✂️ Trim any segment\n🗂 Instant resend for repeated links\n\n3 free downloads every day.\nPremium unlocks 2 GB files — no daily limit.\n\nSend a link to start 🚀

# Delete temp files after sending
CLEANUP_FILES=true

# Health-check HTTP port. PaaS platforms (Koyeb, Render, ...) set PORT
# automatically; the bot then serves a tiny "TurboDL OK" endpoint on it.
# Leave empty locally - no port is opened unless this is set.
PORT=
